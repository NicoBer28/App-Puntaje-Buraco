<!-- custom_spinner_background.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo redondeado del Spinner -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18314F"/>
            <corners android:radius="8dp"/>
            <stroke android:width="1dp" android:color="#18314F"/>
        </shape>
    </item>
    <!-- Flecha negra del Spinner -->
    <item android:drawable="@android:drawable/arrow_down_float"
        android:gravity="end|center_vertical"/>
</layer-list>
