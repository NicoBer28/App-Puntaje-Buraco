<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Último paso!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Elige un apodo para que tus amigos te reconozcan en las partidas."
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etApodo"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ej: Nico_Buraco"
        android:inputType="textPersonName"
        android:background="#1A000000"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnGuardarApodo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar y Empezar a Jugar"/>

</LinearLayout>