<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.nuevapartida.NuevaPartidaFragment">




    <Spinner
        android:id="@+id/spinnerJugadores"
        android:contentDescription="@string/cd_cantidad_jugadores"
        android:layout_width="203dp"
        android:layout_height="66dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/spinner_cant_jugadores"

        app:layout_constraintBottom_toTopOf="@+id/spinner1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Spinner
        android:id="@+id/spinner1"
        android:contentDescription="@string/cd_jugador_1"
        android:layout_width="127dp"
        android:layout_height="58dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/spinner_equipo_uno"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinnerJugadores"
        tools:ignore="MissingConstraints" />

    <Spinner
        android:id="@+id/spinner2"
        android:contentDescription="@string/cd_jugador_2"
        android:layout_width="127dp"
        android:layout_height="58dp"
        android:layout_marginTop="104dp"
        android:background="@drawable/spinner_equipo_uno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinner1"
        tools:ignore="MissingConstraints" />

    <Spinner
        android:id="@+id/spinner3"
        android:contentDescription="@string/cd_jugador_3"

        android:layout_width="127dp"
        android:layout_height="58dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="212dp"
        android:background="@drawable/spinner_equipo_dos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Spinner
        android:id="@+id/spinner4"
        android:contentDescription="@string/cd_jugador_4"
        android:layout_width="127dp"
        android:layout_height="58dp"
        android:layout_marginTop="212dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/spinner_equipo_dos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/btnNuevaPartida"
        android:layout_width="181dp"
        android:layout_height="76dp"
        android:layout_marginBottom="168dp"
        android:background="@drawable/rounded_button"
        android:text="@string/accion_nueva_partida"

        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spinnerJugadores"
        app:layout_constraintVertical_bias="0.877" />

    <Button
        android:id="@+id/btnHistoriales"
        android:layout_width="138dp"
        android:layout_height="79dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/rounded_button"
        android:text="@string/accion_historiales"

        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnUsuario"
        android:layout_width="138dp"
        android:layout_height="79dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/rounded_button"
        android:text="@string/accion_agregar_usuario"

        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nombreUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnCerrarSesion"
        app:layout_constraintEnd_toStartOf="@+id/btnCerrarSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnCerrarSesion" />

    <Button
        android:id="@+id/btnCerrarSesion"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:minHeight="48dp"
        android:text="@string/accion_cerrar_sesion"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aviso de datos que todavía no se subieron (por ejemplo, sin conexión). -->
    <TextView
        android:id="@+id/txtSincronizacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:text="@string/mensaje_cambios_pendientes"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
